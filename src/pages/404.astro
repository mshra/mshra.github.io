---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title="Lost?" description="This page does not exist.">
    <section class="not-found">
        <h1 class="page-heading">
            <span class="name">Oops!</span>
        </h1>

        <p class="message">
            This page doesn't exist — it may have moved, been deleted, or never
            existed at all.
        </p>

        <a href={`${base}/`} class="home-link">← Back to home</a>
    </section>
</BaseLayout>

<style>
    .not-found {
        padding-top: 4rem;
    }

    .message {
        color: #555;
        font-size: 1.0625rem;
        line-height: 1.8;
        max-width: 480px;
        margin-bottom: 2.5rem;
    }

    .home-link {
        font-size: 0.9rem;
        color: #555;
        text-decoration: none;
        transition: color 0.15s ease;
    }

    .home-link:hover {
        color: #111;
    }
</style>
