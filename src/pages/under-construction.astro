---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Construction } from "@lucide/astro";
---

<BaseLayout
    title="Under Construction"
    description="This site is currently under construction."
>
    <section class="pt-16">
        <h1
            class="mb-8 font-serif text-4xl font-normal tracking-tight text-text"
        >
            <Construction class="inline-block w-6 h-6 mr-2" />
            Under Construction
        </h1>

        <p class="mb-10 max-w-120 text-[1.0625rem] leading-relaxed text-[#555]">
            Check back later.
        </p>
    </section>
</BaseLayout>
