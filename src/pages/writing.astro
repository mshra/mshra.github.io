---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

function formatDate(date: Date): string {
    return date.toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
    });
}
---

<BaseLayout
    title="Writing — Aaryan Mishra"
    description="Essays and notes by Aaryan Mishra."
>
    <p class="text-sm text-[#555] mb-12">
        A collection of essays, notes, and half-formed thoughts. Published when
        ready, updated when wrong.
    </p>

    <ul class="list-none p-0 m-0 flex flex-col">
        {
            posts.map((post) => (
                <li class="py-6 border-b border-[#e5e5e5] first:border-t flex flex-col gap-1.5">
                    <a
                        href={`${base}/writing/${post.slug}`}
                        class="text-base font-medium text-[#111] no-underline tracking-tight transition-colors duration-150 hover:text-[#555]"
                    >
                        {post.data.title}
                    </a>
                    {post.data.description && (
                        <p class="text-sm text-[#666] m-0 leading-relaxed">
                            {post.data.description}
                        </p>
                    )}
                    <time
                        class="text-[0.8125rem] text-[#aaa] tabular-nums"
                        datetime={post.data.date.toISOString()}
                    >
                        {formatDate(post.data.date)}
                    </time>
                </li>
            ))
        }
    </ul>

    <footer class="mt-16 pt-8 border-t border-[#e5e5e5]">
        <a
            href={`${base}/`}
            class="text-sm text-[#555] no-underline transition-colors duration-150 hover:text-[#111]"
        >
            ← Back to home
        </a>
    </footer>
</BaseLayout>
