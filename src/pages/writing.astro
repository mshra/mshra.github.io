---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

function formatDate(date: Date): string {
    return date.toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
    });
}
---

<BaseLayout
    title="Writing — Aaryan Mishra"
    description="Essays and notes by Aaryan Mishra."
>
    <h1 class="mb-10 font-serif text-4xl font-normal tracking-tight">
        Writing
    </h1>

    <p class="mb-12 font-mono text-sm text-[#888]">
        Essays, notes, and half-formed thoughts.
    </p>

    <ul class="list-none p-0 m-0 flex flex-col">
        {
            posts.map((post) => (
                <li class="py-6 border-b border-border first:border-t flex flex-col gap-2">
                    <a
                        href={`${base}/writing/${post.slug}`}
                        class="font-serif text-[1.125rem] not-italic no-underline font-normal text-text transition-colors duration-150 hover:text-[#555]"
                    >
                        {post.data.title}
                    </a>
                    {post.data.description && (
                        <p class="text-sm text-[#555] m-0 leading-relaxed">
                            {post.data.description}
                        </p>
                    )}
                    <time
                        class="font-mono text-xs text-[#888] tabular-nums tracking-wide"
                        datetime={post.data.date.toISOString()}
                    >
                        {formatDate(post.data.date)}
                    </time>
                </li>
            ))
        }
    </ul>

    <footer class="mt-16 pt-8">
        <a
            href={`${base}/`}
            class="font-mono text-xs text-[#888] no-underline not-italic tracking-wide transition-colors duration-150 hover:text-text"
        >
            ← home
        </a>
    </footer>
</BaseLayout>
