---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

function formatDate(date: Date): string {
    return date.toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
    });
}
---

<BaseLayout
    title="Writing — Aaryan Arora"
    description="Essays and notes by Aaryan Arora."
>
    <!-- <h1 class="page-heading">
        <span class="name">writing</span>
    </h1> -->

    <p class="intro">
        A collection of essays, notes, and half-formed thoughts. Published when
        ready, updated when wrong.
    </p>

    <ul class="post-list">
        {
            posts.map((post) => (
                <li class="post-item">
                    <a href={`${base}/writing/${post.slug}`} class="post-title">
                        {post.data.title}
                    </a>
                    {post.data.description && (
                        <p class="post-description">{post.data.description}</p>
                    )}
                    <time
                        class="post-date"
                        datetime={post.data.date.toISOString()}
                    >
                        {formatDate(post.data.date)}
                    </time>
                </li>
            ))
        }
    </ul>

    <footer class="page-footer">
        <a href={`${base}/`} class="back-link">← Back to home</a>
    </footer>
</BaseLayout>

<style>
    .intro {
        color: #555;
        margin-bottom: 3rem;
        font-size: 0.95rem;
    }

    .post-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .post-item {
        padding: 1.5rem 0;
        border-bottom: 1px solid #e5e5e5;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .post-item:first-child {
        border-top: 1px solid #e5e5e5;
    }

    .post-title {
        font-size: 1rem;
        font-weight: 500;
        color: #111;
        text-decoration: none;
        letter-spacing: -0.01em;
        transition: color 0.15s ease;
    }

    .post-title:hover {
        color: #555;
        text-decoration: none;
    }

    .post-description {
        font-size: 0.875rem;
        color: #666;
        margin: 0;
        line-height: 1.5;
    }

    .post-date {
        font-size: 0.8125rem;
        color: #aaa;
        font-variant-numeric: tabular-nums;
    }

    .page-footer {
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid #e5e5e5;
    }

    .back-link {
        font-size: 0.9rem;
        color: #555;
        text-decoration: none;
        transition: color 0.15s ease;
    }

    .back-link:hover {
        color: #111;
    }
</style>
