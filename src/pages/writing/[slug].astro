---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts.map((post) => ({
        params: { slug: post.slug },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await post.render();

function formatDate(date: Date): string {
    return date.toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
    });
}
---

<BaseLayout
    title={`${post.data.title} — Aaryan Mishra`}
    description={post.data.description}
>
    <article class="pt-8">
        <header class="mb-12 pb-8 border-b border-[#e5e5e5]">
            <h1 class="text-3xl font-semibold tracking-tight text-[#111] mb-2">
                {post.data.title}
            </h1>
            <time
                class="block text-sm text-[#aaa] tabular-nums"
                datetime={post.data.date.toISOString()}
            >
                {formatDate(post.data.date)}
            </time>
            {
                post.data.description && (
                    <p class="mt-3 mb-0 text-base text-[#555] leading-relaxed">
                        {post.data.description}
                    </p>
                )
            }
        </header>

        <div
            class="prose prose-neutral max-w-none
                   prose-headings:font-semibold prose-headings:tracking-tight prose-headings:text-[#111]
                   prose-p:text-[#222] prose-p:leading-[1.8]
                   prose-a:text-[#111] prose-a:underline prose-a:underline-offset-[3px] prose-a:decoration-[1px] prose-a:decoration-[#ccc] hover:prose-a:text-[#555] hover:prose-a:decoration-[#555]
                   prose-blockquote:border-l-[#e5e5e5] prose-blockquote:text-[#666] prose-blockquote:not-italic
                   prose-code:bg-[#f4f4f4] prose-code:rounded prose-code:px-1.5 prose-code:py-0.5 prose-code:text-[0.875em] prose-code:font-normal prose-code:before:content-none prose-code:after:content-none
                   prose-pre:bg-[#f4f4f4] prose-pre:rounded-md
                   prose-img:rounded-md
                   prose-hr:border-[#e5e5e5]"
        >
            <Content />
        </div>

        <footer class="mt-16 pt-8 border-t border-[#e5e5e5]">
            <a
                href="/writing"
                class="text-sm text-[#555] no-underline transition-colors duration-150 hover:text-[#111]"
            >
                ← Back to writing
            </a>
        </footer>
    </article>
</BaseLayout>
