---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts.map((post) => ({
        params: { slug: post.slug },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await post.render();

function formatDate(date: Date): string {
    return date.toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
    });
}
---

<BaseLayout
    title={`${post.data.title} — Aaryan Arora`}
    description={post.data.description}
>
    <article>
        <header class="post-header">
            <h1 class="page-heading">
                <span class="name">{post.data.title}</span>
            </h1>
            <time class="post-date" datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
            </time>
            {
                post.data.description && (
                    <p class="post-description">{post.data.description}</p>
                )
            }
        </header>

        <div class="post-body">
            <Content />
        </div>

        <footer class="post-footer">
            <a href="/writing" class="back-link">← Back to writing</a>
        </footer>
    </article>
</BaseLayout>

<style>
    article {
        padding-top: 2rem;
    }

    .post-header {
        margin-bottom: 3rem;
        padding-bottom: 2rem;
        border-bottom: 1px solid #e5e5e5;
    }

    .post-date {
        display: block;
        font-size: 0.875rem;
        color: #aaa;
        margin-top: 0.5rem;
        font-variant-numeric: tabular-nums;
    }

    .post-description {
        margin-top: 0.75rem;
        margin-bottom: 0;
        color: #555;
        font-size: 1rem;
        line-height: 1.6;
    }

    /* ── Post body prose styles ── */
    .post-body {
        line-height: 1.8;
        font-size: 1.0625rem;
        color: #222;
    }

    .post-body :global(h2) {
        font-size: 1.2rem;
        font-weight: 600;
        margin-top: 2.5rem;
        margin-bottom: 0.75rem;
        color: #111;
        letter-spacing: -0.02em;
    }

    .post-body :global(h3) {
        font-size: 1.05rem;
        font-weight: 600;
        margin-top: 2rem;
        margin-bottom: 0.5rem;
        color: #111;
    }

    .post-body :global(p) {
        margin-bottom: 1.4rem;
    }

    .post-body :global(a) {
        color: #111;
        text-decoration: underline;
        text-underline-offset: 3px;
        text-decoration-thickness: 1px;
        text-decoration-color: #ccc;
        transition:
            color 0.15s ease,
            text-decoration-color 0.15s ease;
    }

    .post-body :global(a:hover) {
        color: #555;
        text-decoration-color: #555;
    }

    .post-body :global(ul),
    .post-body :global(ol) {
        padding-left: 1.5rem;
        margin-bottom: 1.4rem;
    }

    .post-body :global(li) {
        margin-bottom: 0.4rem;
    }

    .post-body :global(blockquote) {
        border-left: 3px solid #e5e5e5;
        padding-left: 1.25rem;
        color: #666;
        margin: 2rem 0;
        font-style: italic;
    }

    .post-body :global(code) {
        font-family:
            "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
        font-size: 0.875em;
        background: #f4f4f4;
        padding: 0.15em 0.4em;
        border-radius: 3px;
    }

    .post-body :global(pre) {
        background: #f4f4f4;
        padding: 1.25rem;
        border-radius: 6px;
        overflow-x: auto;
        margin-bottom: 1.4rem;
    }

    .post-body :global(pre code) {
        background: none;
        padding: 0;
        font-size: 0.875rem;
    }

    .post-body :global(hr) {
        border: none;
        border-top: 1px solid #e5e5e5;
        margin: 2.5rem 0;
    }

    .post-body :global(img) {
        max-width: 100%;
        height: auto;
        border-radius: 4px;
        margin: 1.5rem 0;
    }

    /* ── Footer ── */
    .post-footer {
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid #e5e5e5;
    }

    .back-link {
        font-size: 0.9rem;
        color: #555;
        text-decoration: none;
        transition: color 0.15s ease;
    }

    .back-link:hover {
        color: #111;
    }
</style>
