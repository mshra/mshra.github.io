---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
    const posts: CollectionEntry<"blog">[] = await getCollection("blog");
    return posts.map((post) => ({
        params: { slug: post.slug },
        props: { post },
    }));
}

interface Props {
    post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await post.render();

function formatDate(date: Date): string {
    return date.toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
    });
}
---

<BaseLayout
    title={`${post.data.title} — Aaryan Mishra`}
    description={post.data.description}
>
    <article class="pt-8">
        <header class="mb-12 pb-8 border-b border-border">
            <h1
                class="font-serif text-4xl font-normal tracking-tight leading-[1.15] text-text mb-3"
            >
                {post.data.title}
            </h1>
            <time
                class="block font-mono text-xs text-[#888] tabular-nums tracking-wide"
                datetime={post.data.date.toISOString()}
            >
                {formatDate(post.data.date)}
            </time>
            {
                post.data.description && (
                    <p class="mt-3 mb-0 font-sans text-base text-[#555] leading-relaxed not-italic">
                        {post.data.description}
                    </p>
                )
            }
        </header>

        <div
            class="prose prose-neutral max-w-none
                   prose-headings:font-serif prose-headings:font-normal prose-headings:tracking-tight prose-headings:text-text
                   prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4
                   prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
                   prose-p:font-sans prose-p:text-text prose-p:leading-[1.8]
                   prose-a:font-sans prose-a:italic prose-a:text-text prose-a:underline prose-a:underline-offset-[3px] prose-a:decoration-1 prose-a:decoration-[#ccc] hover:prose-a:text-[#555] hover:prose-a:decoration-[#555]
                   prose-strong:font-sans prose-strong:font-medium prose-strong:text-text
                   prose-em:font-serif
                   prose-blockquote:font-serif prose-blockquote:text-xl prose-blockquote:font-normal prose-blockquote:not-italic prose-blockquote:border-l-border prose-blockquote:text-[#555]
                   prose-code:font-mono prose-code:bg-[#f5f5f5] prose-code:rounded prose-code:px-1.5 prose-code:py-0.5 prose-code:text-[0.875em] prose-code:font-normal prose-code:text-text prose-code:before:content-none prose-code:after:content-none
                   prose-pre:font-mono prose-pre:bg-[#f5f5f5] prose-pre:rounded-md prose-pre:text-sm
                   prose-img:rounded-sm
                   prose-hr:border-border
                   prose-li:font-sans prose-li:text-text"
        >
            <Content />
        </div>

        <footer class="mt-16 pt-8 border-t border-border">
            <a
                href="/writing"
                class="font-mono text-xs text-[#888] no-underline tracking-wide transition-colors duration-150 hover:text-text"
            >
                ← back to writing
            </a>
        </footer>
    </article>
</BaseLayout>
