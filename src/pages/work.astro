---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const allWork: CollectionEntry<"work">[] = await getCollection("work");
const projects = allWork.sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

function formatYear(date: Date): string {
    return date.toLocaleDateString("en-US", {
        year: "numeric",
    });
}
---

<BaseLayout title="Work" description="Projects and work by Aaryan Mishra.">
    <p class="mb-12 font-mono text-sm text-[#888]">
        Selected projects and work.
    </p>

    <ul class="list-none p-0 m-0 flex flex-col">
        {
            projects.map((project) => (
                <li class="py-6 border-b border-border first:border-t flex flex-col gap-2">
                    <div class="flex items-baseline justify-between gap-4 flex-wrap">
                        {project.data.url ? (
                            <a
                                href={project.data.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="font-serif text-[1.125rem] not-italic no-underline font-normal text-text transition-colors duration-150 hover:text-[#555]"
                            >
                                {project.data.title}
                            </a>
                        ) : (
                            <span class="font-serif text-[1.125rem] not-italic font-normal text-text">
                                {project.data.title}
                            </span>
                        )}
                        <time
                            class="font-mono text-xs text-[#888] tabular-nums tracking-wide shrink-0"
                            datetime={project.data.date.toISOString()}
                        >
                            {formatYear(project.data.date)}
                        </time>
                    </div>
                    {project.data.role && (
                        <p class="font-mono text-xs text-[#888]">
                            {project.data.role}
                        </p>
                    )}
                    {project.data.tags && project.data.tags.length > 0 && (
                        <div class="flex flex-wrap gap-2 mt-1">
                            {project.data.tags.map((tag) => (
                                <span class="font-mono text-xs px-2 py-0.5 bg-border/50 text-[#555] rounded-sm">
                                    {tag}
                                </span>
                            ))}
                        </div>
                    )}
                    {project.data.description && (
                        <p class="text-sm text-[#555] m-0 leading-relaxed mt-1">
                            {project.data.description}
                        </p>
                    )}
                </li>
            ))
        }
    </ul>

    <footer class="mt-16 pt-8">
        <a
            href={`${base}/`}
            class="font-mono text-xs text-[#888] no-underline not-italic tracking-wide transition-colors duration-150 hover:text-text"
        >
            ← home
        </a>
    </footer>
</BaseLayout>
