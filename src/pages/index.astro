---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="Aaryan Mishra"
    description="Software engineer based in Bengaluru. Writing and more."
>
    <section class="pt-16">
        <h1 class="mb-6 text-3xl font-semibold tracking-tight text-[#111]">
            Aaryan Mishra
        </h1>

        <div class="max-w-[540px]">
            <p class="text-[1.0625rem] leading-[1.8] text-[#333] mb-5">
                I'm a software engineer based in Bengaluru. I build things for
                the web, think about systems and design, and occasionally write
                about what I learn along the way.
            </p>
            <p class="text-[1.0625rem] leading-[1.8] text-[#333]">
                You can find my <a
                    href="/writing"
                    class="text-[#111] underline underline-offset-[3px] decoration-[1px] decoration-[#ccc] transition-colors duration-150 hover:text-[#555] hover:decoration-[#555]"
                    >writing here</a
                >.
            </p>
        </div>
    </section>
</BaseLayout>
