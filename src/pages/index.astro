---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="Aaryan Mishra"
    description="Software engineer based in San Francisco. Writing and more."
>
    <section class="home">
        <h1 class="page-heading">
            <span class="name">Aaryan Mishra</span>
        </h1>

        <div class="bio">
            <p>
                I'm a software engineer based in Bengaluru. I build things for
                the web, think about systems and design, and occasionally write
                about what I learn along the way.
            </p>
            <p>
                You can find my <a href="/writing">writing here</a>.
            </p>
        </div>
    </section>
</BaseLayout>

<style>
    .home {
        padding-top: 4rem;
    }

    .bio {
        max-width: 540px;
    }

    .bio p {
        font-size: 1.0625rem;
        line-height: 1.8;
        color: #333;
    }
</style>
