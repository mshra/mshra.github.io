---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="Aaryan Mishra"
    description="Software engineer based in Bengaluru. Writing and more."
>
    <section class="pt-16">
        <h1
            class="mb-8 font-serif text-4xl font-normal tracking-tight text-text"
        >
            Aaryan Mishra
        </h1>

        <div class="max-w-130 space-y-5">
            <p class="text-[1.0625rem] leading-[1.8] text-text">
                I'm a software engineer based in Bengaluru. I build things for
                the web, think about systems and design, and occasionally write
                about what I learn along the way.
            </p>
            <p class="text-[1.0625rem] leading-[1.8] text-text">
                You can find my <a href="/writing">writing here</a>.
            </p>
        </div>
    </section>
</BaseLayout>
